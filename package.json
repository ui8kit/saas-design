{
  "name": "saas-design",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "if command -v bun >/dev/null 2>&1; then bun tools/xgen-link.ts; else echo 'xgen-link: skipped (no bun; only the generators need @ui8kit/codegen)'; fi",
    "extract": "bash tools/extract.sh",
    "render:figma": "bun tools/figma-render.ts",
    "shots": "bun tools/shots.ts",
    "tokens": "bun tools/tokens.ts",
    "brand:emit": "npx -y brand-os@0.3.0 emit --schema fixtures/tokens/brand.contract.json --output fixtures/tokens/brand.generated --force --json",
    "brand:check": "npx -y brand-os@0.3.0 validate --schema fixtures/tokens/brand.contract.json --json && npx -y brand-os@0.3.0 verify --schema fixtures/tokens/brand.contract.json --bundle fixtures/tokens/brand.generated --strict --json",
    "content": "bun tools/content.ts",
    "contract": "bun tools/validate-content.ts",
    "regen": "bash tools/regen.sh",
    "check": "bash tools/check.sh",
    "design-react:build": "cd apps/design-react && bun run build",
    "design-svelte:build": "cd apps/design-svelte && bun run build",
    "site:build": "bash apps/site/scripts/build.sh",
    "shots:design": "bun tools/shots-design.ts",
    "shots:modes": "bun tools/shots-modes.ts all",
    "test:behaviors": "bun tools/test-behaviors.ts",
    "docs:links": "bun tools/check-links.ts",
    "audit:layout": "bun tools/audit-layout.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4",
    "@ui8kit/contract": "0.2.0",
    "ajv": "8",
    "ajv-formats": "3",
    "clsx": "2",
    "lucide-static": "0.460.0",
    "parse5": "7",
    "playwright-core": "1.48.2",
    "svelte": "5",
    "tailwind-merge": "2",
    "tailwindcss": "4",
    "typescript": "^5.9"
  }
}
