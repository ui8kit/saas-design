{
  "schemaVersion": "1.0.0",
  "meta": {
    "name": "Habitus",
    "slug": "habitus",
    "description": "Habit tracking SaaS landing (Figma frame Home 1:10, file saas-landing.fig).",
    "sourceReference": {
      "project": "ui8kit/saas-design"
    }
  },
  "brandThesis": {
    "summary": "Build better habits, one day at a time.",
    "positioning": "Friendly consumer habit tracker with a bold orange surface and soft pastel cards.",
    "personality": [
      "warm",
      "encouraging",
      "clear"
    ],
    "antiPersonality": [
      "corporate",
      "clinical"
    ]
  },
  "designGrammar": {
    "styleDirection": "Bold orange hero band, white page, soft pastel rounded cards, dark footer and premium card.",
    "shapeLanguage": {
      "core": "One large corner radius (40px) on every card and band, pills for buttons and badges, 20px on phone mockups."
    },
    "surfaceLanguage": {
      "base": "white page",
      "depthRule": "no shadows; depth comes from color blocks",
      "accentRule": "orange only for primary actions, badges and the hero band",
      "contrastRule": "dark text on pastel, white text on orange and ink"
    },
    "imageTreatment": {
      "style": "app screenshots in phone frames with a dark 4-7px outline",
      "preferred": [
        "product screenshots",
        "round avatars"
      ],
      "avoid": [
        "stock photography",
        "gradients",
        "drop shadows"
      ]
    },
    "contentVoice": {
      "adjectives": [
        "encouraging",
        "plain",
        "short"
      ],
      "avoid": [
        "jargon",
        "exclamation marks in headings"
      ]
    }
  },
  "componentPolicy": {
    "keepStandard": [
      "button",
      "badge",
      "input",
      "card",
      "accordion"
    ],
    "customBlocks": [
      "hero-phones",
      "app-gallery",
      "faq-tiles"
    ],
    "avoid": [
      "shadows on cards",
      "more than one accent color per card",
      "inline styles"
    ]
  },
