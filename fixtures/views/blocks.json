          },
          {
            "question": "Can I use Habitus offline?",
            "answer": "Yes. Habits are stored on the device and sync when you are back online.",
            "open": false
          },
          {
            "question": "Is there a family plan?",
            "answer": "Premium covers one account. Family sharing is on the roadmap.",
            "open": false
          },
          {
            "question": "How do I cancel?",
