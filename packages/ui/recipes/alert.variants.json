{
  "id": "ui.alert",
  "base": "flex flex-col gap-2 rounded-md px-6 py-4 inset-ring",
  "keys": ["variant"],
  "defaults": { "variant": "default" },
  "byKey": {
    "variant": {
      "default": "bg-card text-card-foreground inset-ring-border",
      "destructive": "bg-destructive/10 text-destructive inset-ring-destructive",
      "success": "bg-primary/10 text-foreground inset-ring-primary",
      "warning": "bg-accent text-accent-foreground inset-ring-border"
    }
  }
}
