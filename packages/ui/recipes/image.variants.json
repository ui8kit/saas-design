{
  "id": "ui.image",
  "base": "block max-w-full",
  "keys": ["variant", "size", "fit", "position", "aspect"],
  "defaults": { "variant": "default", "size": "default", "fit": "cover", "position": "center", "aspect": "auto" },
  "byKey": {
    "aspect": { "auto": "aspect-auto", "square": "aspect-square", "video": "aspect-video" },
    "fit": { "contain": "object-contain", "cover": "object-cover", "fill": "object-fill", "none": "object-none", "scale-down": "object-scale-down" },
    "position": { "bottom": "object-bottom", "center": "object-center", "left": "object-left", "left-bottom": "object-left-bottom", "left-top": "object-left-top", "right": "object-right", "right-bottom": "object-right-bottom", "right-top": "object-right-top", "top": "object-top" },
    "size": { "auto": "", "default": "", "full": "size-full", "lg": "size-16", "md": "size-12", "sm": "size-8", "xl": "size-24", "xs": "size-6" },
    "variant": { "avatar": "rounded-full", "default": "", "logo": "object-contain", "rounded": "rounded-md", "thumbnail": "rounded-md inset-ring inset-ring-border" }
  }
}
