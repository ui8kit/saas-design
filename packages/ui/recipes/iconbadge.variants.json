{
  "id": "ui.iconbadge",
  "base": "inline-flex shrink-0 items-center justify-center rounded-full font-semibold",
  "keys": ["variant", "size"],
  "defaults": { "variant": "default", "size": "default" },
  "byKey": {
    "variant": { "default": "bg-muted text-muted-foreground", "accent": "bg-accent text-accent-foreground", "secondary": "bg-secondary text-secondary-foreground", "outline": "text-foreground inset-ring inset-ring-border", "destructive": "bg-destructive text-destructive-foreground" },
    "size": { "xs": "size-6 text-xs", "sm": "size-8 text-xs", "default": "size-10 text-sm", "lg": "size-12 text-base" }
  }
}
