{
  "id": "ui.dialog",
  "base": "m-auto rounded-lg bg-popover p-8 text-popover-foreground shadow-lg backdrop:bg-foreground/40",
  "keys": ["variant", "size"],
  "defaults": { "variant": "default", "size": "default" },
  "byKey": {
    "size": { "default": "w-full max-w-lg", "full": "h-full w-full max-w-none", "lg": "w-full max-w-2xl", "sm": "w-full max-w-sm", "xl": "w-full max-w-4xl" },
    "variant": { "card": "bg-card text-card-foreground", "default": "", "sheet": "min-h-screen rounded-none" }
  }
}
