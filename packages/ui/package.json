{
  "name": "@saas-design/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UI primitives generated by @ui8kit/codegen for Go templ and Svelte 5 (identical DOM/ARIA). Recipes point at semantic ui-* classes of @saas-design/adapter.",
  "exports": {
    ".": {
      "svelte": "./svelte/ui/index.svelte.ts",
      "default": "./svelte/ui/index.svelte.ts"
    },
    "./svelte/*": "./svelte/*"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "check": "bun scripts/generate.ts --check",
    "parity": "bun --preload ../../tools/svelte-preload.ts scripts/parity.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@ui8kit/codegen": "github:ui8kit/codegen#972b492"
  }
}
