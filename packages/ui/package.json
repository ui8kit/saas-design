{
  "name": "@saas-design/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UI primitives generated by @ui8kit/codegen 2.0 (xgen) for Go templ, Svelte 5 and React 19 (identical DOM/ARIA). Recipes point at semantic ui-* classes of @saas-design/adapter.",
  "exports": {
    ".": {
      "svelte": "./svelte/src/index.ts",
      "default": "./svelte/src/index.ts"
    },
    "./react": "./react/src/index.ts",
    "./svelte/*": "./svelte/*",
    "./showcase.json": "./showcase.json"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts && bun scripts/showcase.ts",
    "check": "bun scripts/generate.ts --check && bun scripts/showcase.ts --check",
    "parity": "bun --preload ../../tools/svelte-preload.ts scripts/parity.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@ui8kit/codegen": "github:ui8kit/codegen#2309848",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
