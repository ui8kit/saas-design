{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@saas-design/ui/react": [
        "../../packages/ui/react/src/index.ts"
      ],
      "@saas-design/blocks/react": [
        "../../packages/blocks/react/index.ts"
      ],
      "@saas-design/icons/react": [
        "../../packages/icons/src/react.tsx"
      ],
      "$design/*": [
        "../../packages/design-docs/src/*"
      ],
      "@saas-design/ui/showcase.json": [
        "../../packages/ui/showcase.json"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    },
    "types": []
  },
  "include": [
    "src",
    "scripts"
  ]
}
