package views

import (
	"github.com/ui8kit/saas-design/packages/ui/templ/ui/container"
	linkplain "github.com/ui8kit/saas-design/packages/ui/templ/ui/link-plain"
)

// PageMeta is the page part of fixtures/views/<page>.json.
type PageMeta struct {
	ID          string `json:"id"`
	Title       string `json:"title"`
	Description string `json:"description"`
	Lang        string `json:"lang"`
	Figma       string `json:"figma"`
}

// Regions groups rendered blocks by landmark: header and footer blocks sit outside <main>.
type Regions struct {
	Header []templ.Component
	Main   []templ.Component
	Footer []templ.Component
}

// Assets are the page-level files: stylesheet, the shared behavior script and the inline no-flash theme snippet.
type Assets struct {
	CSS       string
	JS        string
	ThemeInit string
}

// themeInit inlines packages/ui/behaviors/theme-init.js: the only inline script, it sets .dark before first paint.
func themeInit(js string) templ.Component {
	return templ.Raw("<script>" + js + "</script>")
}

templ Page(meta PageMeta, r Regions, a Assets) {
	<!DOCTYPE html>
	<html lang={ meta.Lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ meta.Title }</title>
			<meta name="description" content={ meta.Description }/>
			<link rel="icon" href="/media/brand-mark.svg" type="image/svg+xml"/>
			@themeInit(a.ThemeInit)
			<link rel="stylesheet" href={ a.CSS }/>
			<script src={ a.JS } defer></script>
		</head>
		<body class="ui-page" data-class="ui-page" data-figma={ meta.Figma }>
			@linkplain.LinkPlain(linkplain.LinkPlainProps{Class: "ui-skip", Href: "#content", Attrs: templ.Attributes{"data-class": "ui-skip"}}) {
				Skip to content
			}
			for _, c := range r.Header {
				@c
			}
			@container.Container(container.ContainerProps{Tag: "main", Attrs: templ.Attributes{"id": "content"}}) {
				for _, c := range r.Main {
					@c
				}
			}
			for _, c := range r.Footer {
				@c
			}
		</body>
	</html>
}
